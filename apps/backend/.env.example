# 服务端端口与 Swagger 开关
PORT=3000
SWAGGER=true

# 对外公开访问的后端地址
PUBLIC_API_BASE_URL=https://your-api-domain.example.com

# 数据库连接串
DATABASE_URL=mysql://root:123456@127.0.0.1:3306/ding

# App 试用天数与 Scheme
MOBILE_TRIAL_DAYS=7
MOBILE_APP_SCHEME=ding

# Expo Push 服务地址，默认即可
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# App Store / Google Play 商品 ID
IOS_MONTHLY_PRODUCT_ID=ding_monthly_ios
IOS_YEARLY_PRODUCT_ID=ding_yearly_ios
ANDROID_MONTHLY_PRODUCT_ID=ding_monthly_android
ANDROID_YEARLY_PRODUCT_ID=ding_yearly_android

# 以下仍是现有微信小程序通知相关配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_TEMPLATE_ID=kWjJcQoG_zJWfnh7V4A3ZosbjhgeCSWN5oBuiePtfd8
WECHAT_NOTIFY_PAGE=pages/index/index

# Notify 接口限流配置
RATE_LIMIT_PER_KEY_PER_MINUTE=5
RATE_LIMIT_PER_IP_PER_MINUTE=30
