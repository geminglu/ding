generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model WeappUser {
  id         String      @id @default(cuid())
  openid     String      @unique
  notifyKeys NotifyKey[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model NotifyKey {
  id        String          @id @default(cuid())
  userId    String
  key       String          @unique
  status    NotifyKeyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  rotatedAt DateTime?
  user      WeappUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

enum NotifyKeyStatus {
  ACTIVE
  ROTATED
}
