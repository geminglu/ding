# 前端请求的后端 API 地址
EXPO_PUBLIC_API_BASE_URL=http://192.168.50.6:3000

# 教程、隐私政策、用户协议、反馈页和联系邮箱
EXPO_PUBLIC_TUTORIAL_URL=http://192.168.50.6:3000/tutorial
EXPO_PUBLIC_PRIVACY_URL=http://192.168.50.6:3000/privacy
EXPO_PUBLIC_TERMS_URL=http://192.168.50.6:3000/terms
EXPO_PUBLIC_FEEDBACK_URL=http://192.168.50.6:3000/feedback
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# RevenueCat 公开 key 与 entitlement 标识
# 未接入订阅联调前可以先留空
EXPO_PUBLIC_IOS_REVENUECAT_API_KEY=
EXPO_PUBLIC_ANDROID_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# App Store / Google Play 商品 ID
EXPO_PUBLIC_IOS_MONTHLY_PRODUCT_ID=ding_monthly_ios
EXPO_PUBLIC_IOS_YEARLY_PRODUCT_ID=ding_yearly_ios
EXPO_PUBLIC_ANDROID_MONTHLY_PRODUCT_ID=ding_monthly_android
EXPO_PUBLIC_ANDROID_YEARLY_PRODUCT_ID=ding_yearly_android

# EAS 项目 ID，用于 Expo 推送 token 获取
# 使用 Expo Go 时可以先留空，开发构建或正式构建时需要填写
EXPO_PUBLIC_EAS_PROJECT_ID=
